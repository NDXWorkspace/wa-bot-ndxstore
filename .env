# Group WhatsApp tujuan notifikasi order
# Cara dapat: add bot ke grup → kirim pesan di grup → buka panel
# http://localhost:3000/admin → Grup WA → copy ID-nya ke sini
GROUP_ID=120363411174055948@g.us

# Admin password untuk akses API Vercel (sama kayak ADMIN_PASSWORD di Vercel)
API_PASSWORD=NDXADMIN2026

# Token bot untuk endpoint /api/admin/* (statistik, orders, update status).
# Server menerima header x-bot-token SEJAJAR sesi Google owner — tanpa expiry,
# tanpa refresh cookie. Nilainya HARUS SAMA dengan BOT_API_TOKEN di Vercel.
# Cara pasang (sekali saja):
# 1. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 2. Vercel dashboard → ndxstoreid → Settings → Environment Variables → tambah
#    BOT_API_TOKEN=<token> → Redeploy
# 3. Paste token yang SAMA di bawah → restart bot
# NDX_BOT_TOKEN=

# (Legacy) cookie sesi browser — umumnya tidak dipakai karena auth Firebase
# tidak menyimpan session cookie. Biarkan kosong kecuali diminta.
# NDX_SESSION=

# Admin number (nomor WA admin, tanpa @c.us)
ADMIN_NUMBER=+6285159898005

# Pairing code login — nomor WA akun BOT (format 628xxx, tanpa +, tanpa spasi).
# Kalau diisi: login pakai kode 8 karakter (lihat terminal / buka http://localhost:3000/qr),
# tanpa perlu scan QR. Kosongkan = login via scan QR seperti biasa.
# Cara pakai di HP: WhatsApp → Perangkat Tertaut → Tautkan dengan nomor telepon → masukkan kode.
PAIRING_NUMBER=6285159898005

# AI Chat - https://text.pollinations.ai (free, no key needed)
AI_API_KEY=
AI_MODEL=openai
AI_API_BASE=https://text.pollinations.ai

# Groq API Key (optional, fallback AI — https://console.groq.com)
GROQ_API_KEY=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

# Groq vision model (optional). Kosongkan = gambar diproses via Pollinations.
# Isi dengan model multimodal terkini dari console.groq.com/docs/models kalau mau pakai Groq.
# GROQ_VISION_MODEL=

# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Log format: text | json
LOG_FORMAT=text

# Colorize console output
LOG_COLOR=true

# Alert webhook for fatal/error (Discord, Telegram, etc.)
# LOG_ALERT_WEBHOOK=https://discord.com/api/webhooks/...

# Health heartbeat interval (ms). 0 = off.
LOG_HEARTBEAT_MS=300000

# Puppeteer / Chrome — biar auto-detect path-nya

# Panel admin localhost (http://localhost:3000/admin).
# HOST default 127.0.0.1 (hanya dari PC ini). Isi 0.0.0.0 kalau perlu
# diakses dari luar — WAJIB isi ADMIN_TOKEN kalau begitu.
# HOST=127.0.0.1
# ADMIN_TOKEN=isi-token-acak-di-sini
